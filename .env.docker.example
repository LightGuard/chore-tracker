# Copy this file to .env.docker, adjust the public origin for the deployment,
# and pass it explicitly:
#
#   docker compose --env-file .env.docker up --detach --build
#
# Never commit .env.docker or secret values. The file is read as Compose
# interpolation and is also passed to the backend as runtime environment.

CHORE_TRACKER_ENV_FILE=.env.docker

# The origin the browser uses. Keep the default for local Docker use.
CHORE_TRACKER_PUBLIC_ORIGIN=http://localhost:8080

# Use 0.0.0.0 to publish on the LAN. Set the public origin and relying-party ID
# to the exact hostname used by browsers when doing so.
CHORE_TRACKER_BIND_ADDRESS=127.0.0.1
CHORE_TRACKER_HTTP_PORT=8080
CHORE_TRACKER_PASSKEY_RP_ID=localhost

# Local Docker uses HTTP. Production requires HTTPS origins and non-console
# email delivery; terminate TLS in front of this deployment first.
CHORE_TRACKER_ENVIRONMENT=development

# Optional SMTP configuration. Prefer a mounted password file in production.
# CHORE_TRACKER_EMAIL_TRANSPORT=smtp
# CHORE_TRACKER_SMTP_HOST=smtp.example.test
# CHORE_TRACKER_SMTP_PORT=587
# CHORE_TRACKER_SMTP_USERNAME=mailer
# CHORE_TRACKER_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# CHORE_TRACKER_EMAIL_FROM_ADDRESS=chores@example.test
