# Runtime environment and HTTP binding
CHORE_TRACKER_ENVIRONMENT=development
CHORE_TRACKER_APP_HOST=127.0.0.1
CHORE_TRACKER_APP_PORT=8000
CHORE_TRACKER_APP_ORIGIN=http://localhost:5173

# Persistent SQLite location. Set this to a mounted volume path in deployments.
CHORE_TRACKER_DATABASE_PATH=./data/chore-tracker.db

# Passkey relying-party configuration. Set production values explicitly.
CHORE_TRACKER_PASSKEY_RP_ID=localhost
CHORE_TRACKER_PASSKEY_ORIGIN=http://localhost:5173

# Email delivery is optional. Leave the transport and SMTP values unset to run
# without email. Supplying an SMTP host and sender enables SMTP automatically;
# set the transport to "console" to keep messages in the application log.
# Incomplete or conflicting email settings stop startup with a clear error.
# CHORE_TRACKER_EMAIL_TRANSPORT=smtp
# CHORE_TRACKER_EMAIL_FROM_ADDRESS=chores@example.test
# CHORE_TRACKER_SMTP_HOST=smtp.example.test
# CHORE_TRACKER_SMTP_PORT=587
# CHORE_TRACKER_SMTP_USERNAME=mailer
# CHORE_TRACKER_SMTP_STARTTLS=true
# Prefer a mounted secret file or CHORE_TRACKER_SMTP_PASSWORD in the environment.
# CHORE_TRACKER_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Weekly report schedule: Monday at 03:00 in the configured IANA timezone.
CHORE_TRACKER_REPORT_TIMEZONE=America/Denver
CHORE_TRACKER_REPORT_DELIVERY_TIME=03:00
# Run the Monday rollover from the API process. Disable only when another
# process owns the schedule or a fixture seeds its own reports and assignments.
CHORE_TRACKER_WEEKLY_ROLLOVER_ENABLED=true
