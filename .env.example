# Runtime environment and HTTP binding
CHORE_TRACKER_ENVIRONMENT=development
CHORE_TRACKER_APP_HOST=127.0.0.1
CHORE_TRACKER_APP_PORT=8000
CHORE_TRACKER_APP_ORIGIN=http://127.0.0.1:5173

# Persistent SQLite location. Set this to a mounted volume path in deployments.
CHORE_TRACKER_DATABASE_PATH=./data/chore-tracker.db

# Passkey relying-party configuration. Set production values explicitly.
CHORE_TRACKER_PASSKEY_RP_ID=localhost
CHORE_TRACKER_PASSKEY_ORIGIN=http://127.0.0.1:5173

# Development writes email messages to the application console.
# For SMTP, set transport, host, sender, and optionally username/password.
CHORE_TRACKER_EMAIL_TRANSPORT=console
CHORE_TRACKER_EMAIL_FROM_ADDRESS=
CHORE_TRACKER_SMTP_HOST=
CHORE_TRACKER_SMTP_PORT=587
CHORE_TRACKER_SMTP_USERNAME=
CHORE_TRACKER_SMTP_STARTTLS=true
# Prefer a mounted secret file or CHORE_TRACKER_SMTP_PASSWORD in the environment.
# CHORE_TRACKER_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Weekly report schedule: Monday at 03:00 in the configured IANA timezone.
CHORE_TRACKER_REPORT_TIMEZONE=America/Denver
CHORE_TRACKER_REPORT_DELIVERY_TIME=03:00
